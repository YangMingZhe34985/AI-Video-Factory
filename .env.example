# Local testing: host MySQL + Redis from docker-compose.local.yml.
# Copy to the project-root .env only if it does not exist; keep existing credentials.
FLASK_ENV=development
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me
JWT_ACCESS_TOKEN_EXPIRES=3600
JWT_REFRESH_TOKEN_EXPIRES=2592000
API_AUTH_REQUIRED=true
AUTO_REPAIR_SCHEMA=true

# Replace password; URL-encode special characters in username/password.
DATABASE_URL=mysql+pymysql://root:password@127.0.0.1:3306/video_factory?charset=utf8mb4
DATABASE_POOL_PRE_PING=true
DATABASE_POOL_RECYCLE_SEC=300
DATABASE_POOL_TIMEOUT_SEC=30
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_CONNECT_TIMEOUT_SEC=10
DATABASE_READ_TIMEOUT_SEC=120
DATABASE_WRITE_TIMEOUT_SEC=120

STORAGE_ROOT=storage
UPLOAD_FOLDER=storage/uploads
MAX_CONTENT_LENGTH_MB=500

DASHSCOPE_API_KEY=
# 新增 Qwen Image 3.0 / Wan3 继续使用旧域名，不需要 Workspace ID。
DASHSCOPE_API_BASE_URL=https://dashscope.aliyuncs.com/api/v1
DASHSCOPE_OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DEEPSEEK_API_KEY=
DEEPSEEK_OPENAI_BASE_URL=https://api.deepseek.com/v1
# Mock tests the complete queue without paid provider calls. Use real explicitly.
MODEL_ADAPTER_MODE=mock
REQUEST_TIMEOUT_SEC=180
DOWNLOAD_TIMEOUT_SEC=600
POLL_INTERVAL_SEC=10
MAX_POLL_ROUNDS=90
VIDEO_COMPRESSION_ENABLED=true
VIDEO_COMPRESSION_CRF=28
VIDEO_COMPRESSION_PRESET=medium
VIDEO_COMPRESSION_AUDIO_BITRATE=128k
FFMPEG_BINARY=
FACTORY_PROMPTS_DIR=../factory_prompts
FAILURE_AGENT_ON_ERROR=true
FAILURE_AGENT_ENABLED=true
FAILURE_AGENT_MAX_RETRIES=1

DEFAULT_VIDEO_UNDERSTANDING_MODEL=qwen3.7-plus
DEFAULT_PROMPT_REWRITE_MODEL=deepseek-v4-flash
DEFAULT_T2V_MODEL=wan2.7-t2v
DEFAULT_IMAGE_MODEL=wan2.6-image
DEFAULT_R2V_FLASH_MODEL=wan2.6-r2v-flash
DEFAULT_I2V_MODEL=wan2.7-i2v
DEFAULT_I2I_TEST_IMAGE_MODEL=wan2.7-image
DEFAULT_I2I_TEST_I2V_MODEL=wan2.6-i2v-flash
I2I_TEST_MALE_DATASET_DIR=workspace/personas/male
I2I_TEST_FEMALE_DATASET_DIR=workspace/personas/female
R2V_REFERENCE_IMAGE_DIRS=workspace/personas/male,workspace/personas/female

T2V_ENABLED=false
FIRST_FRAME_IMAGE_ENABLED=true
I2V_ENABLED=true
R2V_FLASH_ENABLED=false
I2I_TEST_ENABLED=false

WORKFLOW_PARALLEL_ENABLED=true
WORKFLOW_MAX_PARALLEL_NODES=4
WORKFLOW_MAX_PARALLEL_POLLS=2
JOB_QUEUE_ENABLED=true
JOB_MAX_CONCURRENT_RUNS=2
JOB_QUEUE_POLL_INTERVAL_SEC=1

# Local Agent Studio + /api/skills; also start the agent-worker process.
AGENT_MODE_ENABLED=true
AGENT_ACCEPT_NEW_RUNS=true
# Comma-separated JWT user identities; empty allows all authenticated users.
AGENT_ALLOWED_USERS=
AGENT_MAX_BUDGET=500
# v2 creation checks only the understanding minimum, not future generation.
AGENT_DEFAULT_BUDGET=100
AGENT_MIN_RUN_CREDITS=3
# Zero always requires approval; positive values allow affordable Simple plans.
AGENT_AUTO_APPROVE_CREDITS=0
# Empty uses DEFAULT_PROMPT_REWRITE_MODEL (qwen_chat compatible adapter).
AGENT_PLANNER_MODEL=
# Intake/Director fall back to AGENT_PLANNER_MODEL, then DEFAULT_PROMPT_REWRITE_MODEL.
AGENT_INTAKE_MODEL=
AGENT_DIRECTOR_MODEL=
AGENT_RESEARCH_MODEL=
AGENT_CREATIVE_MODEL=
AGENT_PROMPT_SMITH_MODEL=
# Story v2 stops at storyboard approval until Phase D video production is ready.
AGENT_STORY_V2_ENABLED=false
# Explicitly approve production in Studio; no automatic historical-run billing.
AGENT_STORY_PRODUCTION_ENABLED=false
# Local composition, structural QC and delivery after video approval (no model calls).
AGENT_STORY_DELIVERY_ENABLED=false
AGENT_MAX_PARALLEL_SHOTS=3
AGENT_MAX_SHOT_AUTO_REPAIRS=2
AGENT_MAX_SHOT_REPAIR_CREDITS=60
AGENT_MAX_STORY_SHOTS=30
AGENT_STORY_DURATION_TOLERANCE_RATIO=0.1
# Candidate only; quality against first-frame video is not yet validated.
AGENT_ENABLE_KEYFRAME_BRIDGE=false
# Capability-catalog example; replace with a compatible enabled vision model.
# An empty value follows the same fallback. A text-only fallback fails with
# MODEL_CAPABILITY_MISMATCH; CineCrew never silently chooses another model.
AGENT_VISION_MODEL=qwen3.7-plus
# Agent v2 attachment limits: count, image MiB, video duration in seconds.
AGENT_MAX_ATTACHMENTS=8
AGENT_MAX_IMAGE_MB=20
AGENT_MAX_VIDEO_SEC=300
# Maximum human clarification rounds for Agent v2.
AGENT_MAX_CLARIFY_ROUNDS=2
# Empty uses STORAGE_ROOT/agent/checkpoints.sqlite. Preserve this on restart.
AGENT_CHECKPOINT_PATH=
AGENT_POLL_INTERVAL_SEC=3

# Research remains offline until a real search provider is explicitly integrated.
AGENT_SEARCH_PROVIDER=mock
AGENT_SEARCH_TIMEOUT_SEC=10
# Demonstration estimate, not a provider price.
AGENT_SEARCH_COST_PER_CALL=0.2
AGENT_FETCH_MAX_BYTES=2000000
AGENT_REFERENCE_MAX_MB=10
AGENT_RESEARCH_MAX_QUERIES=6
AGENT_RESEARCH_MAX_FETCHES=6
AGENT_MAX_REFERENCE_DOWNLOADS=24
# Estimated credit budget per budget_scope for skill calls (see docs/architecture/tool_registry.md)
SKILL_DEFAULT_BUDGET=100
## Local shared MQ; migrate DB and start Redis + mq-worker before testing.
# All backend/Agent/MQ processes must read this same .env and share storage.
MQ_ENABLED=true
REDIS_URL=redis://127.0.0.1:6379/0
MQ_LEASE_SEC=900
MQ_MAX_ATTEMPTS=3
MQ_TICK_SEC=2

# Agent v3 foundation: runtime routing lands in V3; keep disabled for now.
AGENT_V3_ENABLED=false
AGENT_V3_PLANNING_CREDITS=20
AGENT_V3_MAX_DELEGATION_DEPTH=3
# Active seconds per delegation (excludes waiting for the user or child agents).
AGENT_V3_DELEGATION_ACTIVE_SEC=600
AGENT_V3_DEFAULT_TEXT_MODEL=deepseek-v4.1-flash
AGENT_V3_DEFAULT_VISION_MODEL=qwen3.7-plus
AGENT_PRODUCER_MODEL=
AGENT_CRITIC_MODEL=
AGENT_REPAIR_MODEL=
