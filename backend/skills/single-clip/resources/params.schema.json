{
  "$defs": {
    "ImageStep": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "t2i",
            "i2i"
          ],
          "title": "Mode",
          "type": "string"
        },
        "model_id": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Model Id",
          "type": "string"
        },
        "prompt": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Prompt",
          "type": "string"
        },
        "reference_attachment_ids": {
          "items": {
            "type": "string"
          },
          "title": "Reference Attachment Ids",
          "type": "array"
        },
        "params": {
          "additionalProperties": true,
          "title": "Params",
          "type": "object"
        },
        "n": {
          "default": 1,
          "maximum": 4,
          "minimum": 1,
          "title": "N",
          "type": "integer"
        }
      },
      "required": [
        "mode",
        "model_id",
        "prompt"
      ],
      "title": "ImageStep",
      "type": "object"
    },
    "SimpleDraft": {
      "additionalProperties": false,
      "properties": {
        "recipe": {
          "enum": [
            "image_edit",
            "image_create",
            "single_clip"
          ],
          "title": "Recipe",
          "type": "string"
        },
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "image": {
          "anyOf": [
            {
              "$ref": "#/$defs/ImageStep"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "video": {
          "anyOf": [
            {
              "$ref": "#/$defs/VideoStep"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "assumptions": {
          "items": {
            "type": "string"
          },
          "maxItems": 10,
          "title": "Assumptions",
          "type": "array"
        },
        "rationale": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "recipe",
        "title",
        "rationale"
      ],
      "title": "SimpleDraft",
      "type": "object"
    },
    "VideoStep": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "const": "i2v",
          "default": "i2v",
          "title": "Mode",
          "type": "string"
        },
        "model_id": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Model Id",
          "type": "string"
        },
        "prompt": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Prompt",
          "type": "string"
        },
        "first_frame": {
          "enum": [
            "user_attachment",
            "generated_image"
          ],
          "title": "First Frame",
          "type": "string"
        },
        "first_frame_attachment_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "First Frame Attachment Id"
        },
        "params": {
          "additionalProperties": true,
          "title": "Params",
          "type": "object"
        }
      },
      "required": [
        "model_id",
        "prompt",
        "first_frame"
      ],
      "title": "VideoStep",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "plan": {
      "$ref": "#/$defs/SimpleDraft"
    },
    "goal": {
      "anyOf": [
        {
          "maxLength": 2000,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Goal"
    }
  },
  "required": [
    "plan"
  ],
  "title": "Params",
  "type": "object"
}
