{
  "tool": "qc_video",
  "resolved_input_schema": {
    "$defs": {
      "DurationConstraint": {
        "additionalProperties": false,
        "properties": {
          "target_duration_sec": {
            "maximum": 600,
            "minimum": 1,
            "title": "Target Duration Sec",
            "type": "number"
          },
          "duration_tolerance_sec": {
            "maximum": 120,
            "minimum": 0,
            "title": "Duration Tolerance Sec",
            "type": "number"
          },
          "mode": {
            "enum": [
              "approx",
              "exact",
              "at_most"
            ],
            "title": "Mode",
            "type": "string"
          }
        },
        "required": [
          "target_duration_sec",
          "duration_tolerance_sec",
          "mode"
        ],
        "title": "DurationConstraint",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "target_aspect_ratio": {
        "anyOf": [
          {
            "enum": [
              "16:9",
              "9:16",
              "1:1",
              "4:3",
              "3:4"
            ],
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Target Aspect Ratio"
      },
      "target_size": {
        "anyOf": [
          {
            "maxLength": 19,
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Target Size"
      },
      "plan_version": {
        "minimum": 1,
        "title": "Plan Version",
        "type": "integer"
      },
      "artifact_id": {
        "maxLength": 100,
        "minLength": 1,
        "title": "Artifact Id",
        "type": "string"
      },
      "video_artifact_ids": {
        "items": {
          "type": "string"
        },
        "maxItems": 120,
        "minItems": 1,
        "title": "Video Artifact Ids",
        "type": "array"
      },
      "duration_constraint": {
        "anyOf": [
          {
            "$ref": "#/$defs/DurationConstraint"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      }
    },
    "required": [
      "plan_version",
      "artifact_id",
      "video_artifact_ids"
    ],
    "title": "QcInput",
    "type": "object"
  },
  "io_types": {
    "inputs": {
      "artifact_id": "video",
      "video_artifact_ids": "video[]"
    },
    "outputs": {
      "passed": "json",
      "checks": "json",
      "warnings": "json"
    }
  },
  "authoring": {
    "purpose": "只读作者合同，不是可由 Agent 直接调用的函数，也不是审批许可。",
    "resolved_schema_notice": "resolved_input_schema 描述引用解析及服务端注入后的工具载荷；编写 PlanNode.inputs 时必须遵守字段放置规则。",
    "plan_node_fields": [],
    "server_injected_fields": [
      "plan_version"
    ],
    "forbidden_input_fields": [
      "model_id",
      "params",
      "template_id",
      "plan_version"
    ],
    "model_selection": "生成节点 model_id/params 写在 PlanNode 顶层；无指定模型可置 model_id=null，由 check_plan 解析默认。非生成节点 model_id=null、params={}。",
    "references": {
      "existing_media": {
        "artifact": "REPLACE_OWNED_ARTIFACT_ID"
      },
      "upstream_output": {
        "ref": "node.output"
      },
      "rules": [
        "artifact/ref 对象只能有该单个键。真实 ID 必须属于当前 Run；node.output 必须是对应 io_types.outputs 的命名输出。",
        "仅在工具声明且编译器支持的输入位置使用类型匹配的引用。媒体位置接受工件或上游媒体；json 位置还须符合对应 Schema/特殊映射，不代表任意引用均可接受。prompt、params 和未声明位置不能夹带引用。",
        "数组字段可用单媒体引用组成数组，或整个字段引用同类型数组输出；数组元素不能引用数组输出，解析器不做 flatten。",
        "示例 ID 只是形状占位，必须替换；引用本身不证明素材存在、质量或批准。"
      ]
    },
    "completion_outputs": "io_types.outputs 是 Plan 节点完成后的命名输出；异步 Job 的 job_id/status/prompts 等回执不能作为 Plan 媒体引用。",
    "notes": [
      "artifact_id 必须为对应 compose 成片，video_artifact_ids 与该 compose 的有序片段一致。",
      "使用 depends_on 把对应 probe 节点设为控制前驱；QC 只验证媒体结构/批准时长，不做生成画面艺术评价。",
      "用户明确比例时，编译器冻结 inputs.target_aspect_ratio 与 target_size（偶数 width*height）；显式冲突阻塞，不能放在 params。目标成片经实际媒体 QC 核验。"
    ]
  }
}
