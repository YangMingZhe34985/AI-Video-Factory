{
  "tool": "generate_video",
  "resolved_input_schema": {
    "additionalProperties": false,
    "properties": {
      "mode": {
        "enum": [
          "t2v",
          "i2v",
          "r2v"
        ],
        "title": "Mode",
        "type": "string"
      },
      "prompt": {
        "maxLength": 8000,
        "minLength": 1,
        "title": "Prompt",
        "type": "string"
      },
      "first_frame_artifact_id": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Required for i2v.",
        "title": "First Frame Artifact Id"
      },
      "reference_artifact_ids": {
        "description": "Required for r2v (at least one).",
        "items": {
          "type": "string"
        },
        "maxItems": 20,
        "title": "Reference Artifact Ids",
        "type": "array"
      },
      "model_id": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Model Id"
      },
      "params": {
        "additionalProperties": true,
        "title": "Params",
        "type": "object"
      },
      "template_id": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Template Id"
      }
    },
    "required": [
      "mode",
      "prompt"
    ],
    "title": "GenerateVideoInput",
    "type": "object"
  },
  "io_types": {
    "inputs": {
      "prompt": "text",
      "first_frame_artifact_id": "image",
      "reference_artifact_ids": "image[]"
    },
    "outputs": {
      "video": "video"
    }
  },
  "authoring": {
    "purpose": "只读作者合同，不是可由 Agent 直接调用的函数，也不是审批许可。",
    "resolved_schema_notice": "resolved_input_schema 描述引用解析及服务端注入后的工具载荷；编写 PlanNode.inputs 时必须遵守字段放置规则。",
    "plan_node_fields": [
      "model_id",
      "params"
    ],
    "server_injected_fields": [],
    "forbidden_input_fields": [
      "model_id",
      "params",
      "template_id",
      "plan_version"
    ],
    "model_selection": "生成节点 model_id/params 写在 PlanNode 顶层；无指定模型可置 model_id=null，由 check_plan 解析默认。非生成节点 model_id=null、params={}。",
    "references": {
      "existing_media": {
        "artifact": "REPLACE_OWNED_ARTIFACT_ID"
      },
      "upstream_output": {
        "ref": "node.output"
      },
      "rules": [
        "artifact/ref 对象只能有该单个键。真实 ID 必须属于当前 Run；node.output 必须是对应 io_types.outputs 的命名输出。",
        "仅在工具声明且编译器支持的输入位置使用类型匹配的引用。媒体位置接受工件或上游媒体；json 位置还须符合对应 Schema/特殊映射，不代表任意引用均可接受。prompt、params 和未声明位置不能夹带引用。",
        "数组字段可用单媒体引用组成数组，或整个字段引用同类型数组输出；数组元素不能引用数组输出，解析器不做 flatten。",
        "示例 ID 只是形状占位，必须替换；引用本身不证明素材存在、质量或批准。"
      ]
    },
    "completion_outputs": "io_types.outputs 是 Plan 节点完成后的命名输出；异步 Job 的 job_id/status/prompts 等回执不能作为 Plan 媒体引用。",
    "notes": [
      "mode=t2v 不接受首帧/参考图；i2v 仅用 first_frame_artifact_id；r2v 仅用非空 reference_artifact_ids。",
      "能力与开关必须允许该模式；每节点仅生成一个视频，params.duration 为输出秒数。"
    ]
  }
}
