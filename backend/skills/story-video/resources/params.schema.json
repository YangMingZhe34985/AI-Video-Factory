{
  "$defs": {
    "Act": {
      "additionalProperties": false,
      "properties": {
        "act_id": {
          "pattern": "^[A-Za-z0-9_-]{1,40}$",
          "title": "Act Id",
          "type": "string"
        },
        "title": {
          "maxLength": 60,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "summary": {
          "maxLength": 600,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "act_id",
        "title",
        "summary"
      ],
      "title": "Act",
      "type": "object"
    },
    "Beat": {
      "additionalProperties": false,
      "properties": {
        "beat_id": {
          "pattern": "^[A-Za-z0-9_-]{1,40}$",
          "title": "Beat Id",
          "type": "string"
        },
        "act_id": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Act Id",
          "type": "string"
        },
        "summary": {
          "maxLength": 400,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "duration_sec": {
          "minimum": 1,
          "title": "Duration Sec",
          "type": "integer"
        },
        "character_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "title": "Character Ids",
          "type": "array"
        },
        "location": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Location",
          "type": "string"
        },
        "emotion": {
          "maxLength": 60,
          "minLength": 1,
          "title": "Emotion",
          "type": "string"
        }
      },
      "required": [
        "beat_id",
        "act_id",
        "summary",
        "duration_sec",
        "location",
        "emotion"
      ],
      "title": "Beat",
      "type": "object"
    },
    "Character": {
      "additionalProperties": false,
      "properties": {
        "character_id": {
          "pattern": "^[A-Za-z0-9_-]{1,40}$",
          "title": "Character Id",
          "type": "string"
        },
        "name": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "role": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Role",
          "type": "string"
        },
        "lock_description": {
          "maxLength": 600,
          "minLength": 1,
          "title": "Lock Description",
          "type": "string"
        },
        "personality": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Personality",
          "type": "string"
        },
        "reference": {
          "$ref": "#/$defs/CharacterReference"
        }
      },
      "required": [
        "character_id",
        "name",
        "role",
        "lock_description",
        "personality",
        "reference"
      ],
      "title": "Character",
      "type": "object"
    },
    "CharacterReference": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "enum": [
            "research",
            "attachment",
            "generate"
          ],
          "title": "Source",
          "type": "string"
        },
        "artifact_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 3,
          "title": "Artifact Ids",
          "type": "array"
        },
        "research_entity_id": {
          "anyOf": [
            {
              "maxLength": 40,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Research Entity Id"
        },
        "generate_prompt": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Generate Prompt"
        }
      },
      "required": [
        "source"
      ],
      "title": "CharacterReference",
      "type": "object"
    },
    "FrameSpec": {
      "additionalProperties": false,
      "properties": {
        "method": {
          "enum": [
            "generate",
            "tail_frame",
            "user_image"
          ],
          "title": "Method",
          "type": "string"
        },
        "image_mode": {
          "anyOf": [
            {
              "enum": [
                "t2i",
                "i2i"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Image Mode"
        },
        "model_id": {
          "anyOf": [
            {
              "maxLength": 120,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Id"
        },
        "prompt": {
          "default": "",
          "maxLength": 8000,
          "title": "Prompt",
          "type": "string"
        },
        "reference_artifact_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 24,
          "title": "Reference Artifact Ids",
          "type": "array"
        }
      },
      "required": [
        "method"
      ],
      "title": "FrameSpec",
      "type": "object"
    },
    "MotionSpec": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "default": "i2v",
          "enum": [
            "i2v",
            "first_last_frame"
          ],
          "title": "Mode",
          "type": "string"
        },
        "model_id": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Model Id",
          "type": "string"
        },
        "prompt": {
          "default": "",
          "maxLength": 8000,
          "title": "Prompt",
          "type": "string"
        },
        "params": {
          "additionalProperties": true,
          "title": "Params",
          "type": "object"
        }
      },
      "required": [
        "model_id"
      ],
      "title": "MotionSpec",
      "type": "object"
    },
    "Option": {
      "additionalProperties": false,
      "properties": {
        "option_id": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Option Id",
          "type": "string"
        },
        "label": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "detail": {
          "anyOf": [
            {
              "maxLength": 300,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detail"
        },
        "image_artifact_id": {
          "anyOf": [
            {
              "maxLength": 80,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Image Artifact Id"
        }
      },
      "required": [
        "option_id",
        "label"
      ],
      "title": "Option",
      "type": "object"
    },
    "Question": {
      "additionalProperties": false,
      "properties": {
        "question_id": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Question Id",
          "type": "string"
        },
        "text": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "why": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Why",
          "type": "string"
        },
        "options": {
          "items": {
            "$ref": "#/$defs/Option"
          },
          "maxItems": 4,
          "minItems": 2,
          "title": "Options",
          "type": "array"
        },
        "recommended_option_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Recommended Option Id"
        },
        "allow_free_text": {
          "default": false,
          "title": "Allow Free Text",
          "type": "boolean"
        },
        "blocking": {
          "default": true,
          "title": "Blocking",
          "type": "boolean"
        },
        "default_option_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Default Option Id"
        }
      },
      "required": [
        "question_id",
        "text",
        "why",
        "options"
      ],
      "title": "Question",
      "type": "object"
    },
    "Scene": {
      "additionalProperties": false,
      "properties": {
        "scene_id": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Scene Id",
          "type": "string"
        },
        "location": {
          "maxLength": 120,
          "title": "Location",
          "type": "string"
        },
        "time_of_day": {
          "maxLength": 40,
          "title": "Time Of Day",
          "type": "string"
        },
        "summary": {
          "maxLength": 300,
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "scene_id",
        "location",
        "time_of_day",
        "summary"
      ],
      "title": "Scene",
      "type": "object"
    },
    "ShotPlan": {
      "additionalProperties": false,
      "properties": {
        "shot_id": {
          "pattern": "^s[0-9]{2,3}$",
          "title": "Shot Id",
          "type": "string"
        },
        "scene_id": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Scene Id",
          "type": "string"
        },
        "order": {
          "minimum": 1,
          "title": "Order",
          "type": "integer"
        },
        "beat_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 40,
          "title": "Beat Ids",
          "type": "array"
        },
        "character_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "title": "Character Ids",
          "type": "array"
        },
        "summary": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "framing": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Framing",
          "type": "string"
        },
        "duration_sec": {
          "exclusiveMinimum": 0,
          "maximum": 600,
          "title": "Duration Sec",
          "type": "number"
        },
        "transition_in": {
          "enum": [
            "start",
            "tail_frame",
            "independent",
            "keyframe_bridge",
            "hard_cut"
          ],
          "title": "Transition In",
          "type": "string"
        },
        "first_frame": {
          "$ref": "#/$defs/FrameSpec"
        },
        "end_frame": {
          "anyOf": [
            {
              "$ref": "#/$defs/FrameSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "motion": {
          "$ref": "#/$defs/MotionSpec"
        },
        "depends_on": {
          "items": {
            "type": "string"
          },
          "maxItems": 30,
          "title": "Depends On",
          "type": "array"
        },
        "rationale": {
          "default": "",
          "maxLength": 300,
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "shot_id",
        "scene_id",
        "order",
        "summary",
        "framing",
        "duration_sec",
        "transition_in",
        "first_frame",
        "motion"
      ],
      "title": "ShotPlan",
      "type": "object"
    },
    "Story": {
      "additionalProperties": false,
      "properties": {
        "logline": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Logline",
          "type": "string"
        },
        "synopsis": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Synopsis",
          "type": "string"
        },
        "acts": {
          "items": {
            "$ref": "#/$defs/Act"
          },
          "maxItems": 6,
          "minItems": 1,
          "title": "Acts",
          "type": "array"
        },
        "beats": {
          "items": {
            "$ref": "#/$defs/Beat"
          },
          "maxItems": 40,
          "minItems": 1,
          "title": "Beats",
          "type": "array"
        }
      },
      "required": [
        "logline",
        "synopsis",
        "acts",
        "beats"
      ],
      "title": "Story",
      "type": "object"
    },
    "StoryDraft": {
      "additionalProperties": false,
      "properties": {
        "recipe": {
          "const": "story_video",
          "default": "story_video",
          "title": "Recipe",
          "type": "string"
        },
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "target_duration_sec": {
          "exclusiveMinimum": 0,
          "maximum": 600,
          "title": "Target Duration Sec",
          "type": "number"
        },
        "aspect_ratio": {
          "default": "16:9",
          "enum": [
            "16:9",
            "9:16",
            "1:1",
            "4:3",
            "3:4"
          ],
          "title": "Aspect Ratio",
          "type": "string"
        },
        "scenes": {
          "items": {
            "$ref": "#/$defs/Scene"
          },
          "maxItems": 12,
          "minItems": 1,
          "title": "Scenes",
          "type": "array"
        },
        "shots": {
          "items": {
            "$ref": "#/$defs/ShotPlan"
          },
          "maxItems": 120,
          "minItems": 1,
          "title": "Shots",
          "type": "array"
        },
        "rationale": {
          "default": "",
          "maxLength": 1500,
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "title",
        "target_duration_sec",
        "scenes",
        "shots"
      ],
      "title": "StoryDraft",
      "type": "object"
    },
    "StoryPackage": {
      "additionalProperties": false,
      "properties": {
        "story": {
          "$ref": "#/$defs/Story"
        },
        "characters": {
          "items": {
            "$ref": "#/$defs/Character"
          },
          "maxItems": 8,
          "title": "Characters",
          "type": "array"
        },
        "style": {
          "$ref": "#/$defs/StyleGuide"
        },
        "open_questions": {
          "items": {
            "$ref": "#/$defs/Question"
          },
          "maxItems": 3,
          "title": "Open Questions",
          "type": "array"
        }
      },
      "required": [
        "story",
        "style"
      ],
      "title": "StoryPackage",
      "type": "object"
    },
    "StyleGuide": {
      "additionalProperties": false,
      "properties": {
        "visual_style": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Visual Style",
          "type": "string"
        },
        "palette": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Palette",
          "type": "string"
        },
        "lighting": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Lighting",
          "type": "string"
        },
        "camera_language": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Camera Language",
          "type": "string"
        },
        "prompt_prefix": {
          "maxLength": 400,
          "minLength": 1,
          "title": "Prompt Prefix",
          "type": "string"
        },
        "negative_prompt": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Negative Prompt"
        }
      },
      "required": [
        "visual_style",
        "palette",
        "lighting",
        "camera_language",
        "prompt_prefix"
      ],
      "title": "StyleGuide",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "plan": {
      "$ref": "#/$defs/StoryDraft"
    },
    "story": {
      "$ref": "#/$defs/StoryPackage"
    },
    "goal": {
      "anyOf": [
        {
          "maxLength": 2000,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Goal"
    },
    "compress_output": {
      "default": false,
      "title": "Compress Output",
      "type": "boolean"
    }
  },
  "required": [
    "plan",
    "story"
  ],
  "title": "Params",
  "type": "object"
}
